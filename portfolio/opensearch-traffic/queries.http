# Execute individual requests in OpenSearch Dashboards -> Dev Tools.
# 1. TCP destination port 80
GET packets-mbm-*/_search
{"query":{"term":{"tcp.dstport":80}}}

# 2. DNS requests for a domain
GET packets-mbm-*/_search
{"query":{"term":{"dns.qry.name":"example.invalid"}}}

# 3. Large packets
GET packets-mbm-*/_search
{"query":{"range":{"frame.len":{"gte":1200}}}}

# 4. HTTP requests
GET packets-mbm-*/_search
{"query":{"term":{"http.request.method":"GET"}}}

# 5. RST flag: keyword representation in this sample is 0x0004
GET packets-mbm-*/_search
{"query":{"term":{"tcp.flags":"0x0004"}}}

# 6. Source distribution
GET packets-mbm-*/_search
{"size":0,"aggs":{"top_sources":{"terms":{"field":"ip.src","size":10}}}}

# 7. Packet count by minute
GET packets-mbm-*/_search
{"size":0,"aggs":{"packets_over_time":{"date_histogram":{"field":"frame.time_epoch","fixed_interval":"1m"}}}}
